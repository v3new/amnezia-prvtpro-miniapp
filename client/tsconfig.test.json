{
  // Тесты клиента гоняет bun, а не vite: им нужны типы bun, но подмешивать их
  // в основной конфиг нельзя — Bun переопределяет DOM-овский fetch, на котором
  // держится dev-mock. Поэтому тесты типизируем отдельным проходом.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["bun"]
  },
  "include": ["src/**/*.test.ts"],
  "exclude": []
}
